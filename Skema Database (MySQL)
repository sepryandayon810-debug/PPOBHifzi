-- Users / Agen
CREATE TABLE users (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name VARCHAR(100),
    phone VARCHAR(15),
    email VARCHAR(100),
    saldo DECIMAL(15,2) DEFAULT 0,
    pin VARCHAR(6),
    role ENUM('admin','agen','reseller') DEFAULT 'agen',
    upline_id INT,
    markup_percent DECIMAL(5,2) DEFAULT 2.00,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (upline_id) REFERENCES users(id)
);

-- Produk PPOB
CREATE TABLE products (
    id INT PRIMARY KEY AUTO_INCREMENT,
    code VARCHAR(50) UNIQUE NOT NULL,
    name VARCHAR(100) NOT NULL,
    category ENUM('pulsa','data','token','pln','bpjs','pdam','internet','tv','game','emoney'),
    provider VARCHAR(50),
    base_price DECIMAL(15,2) NOT NULL,
    selling_price DECIMAL(15,2) NOT NULL,
    description TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Transaksi
CREATE TABLE transactions (
    id VARCHAR(50) PRIMARY KEY,
    user_id INT NOT NULL,
    product_code VARCHAR(50) NOT NULL,
    target_number VARCHAR(50) NOT NULL,
    amount DECIMAL(15,2) NOT NULL,
    sn VARCHAR(100),
    status ENUM('pending','success','failed','refunded') DEFAULT 'pending',
    response_data JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (product_code) REFERENCES products(code)
);

-- Deposit
CREATE TABLE deposits (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    amount DECIMAL(15,2) NOT NULL,
    method ENUM('transfer','qris','va','cash'),
    bank_name VARCHAR(50),
    account_number VARCHAR(50),
    status ENUM('pending','success','rejected') DEFAULT 'pending',
    proof_image VARCHAR(255),
    approved_by INT,
    approved_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Komisi
CREATE TABLE commissions (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    transaction_id VARCHAR(50),
    amount DECIMAL(15,2) NOT NULL,
    level INT DEFAULT 1,
    status ENUM('pending','paid') DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (transaction_id) REFERENCES transactions(id)
);
